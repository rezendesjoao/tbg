<div id="tbg-chat-bar" class="tbg-bar" role="group" aria-label="{{label}}">
    <button type="button" class="tbg-bar__speaker" data-tooltip="" aria-label="{{label}}"><img class="tbg-bar__portrait" alt="" hidden><i class="tbg-bar__icon" inert hidden></i></button>
    <input type="text" class="tbg-bar__input" maxlength="{{maxLength}}" placeholder="{{placeholder}}" aria-label="{{label}}" autocomplete="off" spellcheck="true" enterkeyhint="send">
    <span class="tbg-bar__count" aria-hidden="true">0/{{maxLength}}</span>
</div>
