<div class="tbg-banner" data-message-id="{{id}}">
    <div class="tbg-bubble tbg-bubble--{{kind}} tbg-banner__card">{{#if name}}<span class="tbg-bubble__speaker">{{#if portrait}}<img class="tbg-bubble__portrait" src="{{portrait}}" alt="">{{else if iconClass}}<i class="tbg-bubble__portrait {{iconClass}}" inert></i>{{/if}}<span class="tbg-bubble__name">{{name}}</span></span> {{/if}}<span class="tbg-bubble__text">{{{content}}}</span></div>
</div>
