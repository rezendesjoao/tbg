<div class="tbg-bubble tbg-bubble--{{kind}}" data-message-id="{{id}}" data-token-id="{{tokenId}}">
    {{#if portrait}}<img class="tbg-bubble__portrait" src="{{portrait}}" alt="">{{/if}}
    {{#if showName}}<span class="tbg-bubble__name">{{name}}:</span>{{/if}}
    <span class="tbg-bubble__text">{{{content}}}</span>
</div>
