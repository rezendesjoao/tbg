<div class="tbg-bubble tbg-bubble--{{kind}}" data-message-id="{{id}}"{{#if tokenId}} data-token-id="{{tokenId}}"{{/if}}>
    {{#if name}}<span class="tbg-bubble__speaker">{{#if portrait}}<img class="tbg-bubble__portrait" src="{{portrait}}" alt="">{{else if portraitIcon}}<i class="tbg-bubble__portrait {{portraitIcon}}" inert></i>{{/if}}<span class="tbg-bubble__name">{{name}}</span></span> {{/if}}{{#if icon}}<img class="tbg-bubble__icon" src="{{icon}}" alt="">{{else if iconClass}}<i class="tbg-bubble__icon {{iconClass}}" inert></i>{{/if}}<span class="tbg-bubble__text">{{{content}}}</span>
</div>
