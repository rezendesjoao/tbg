<div class="tbg-bubble tbg-bubble--{{kind}}" data-message-id="{{id}}" data-token-id="{{tokenId}}">
    {{#if showName}}<span class="tbg-bubble__speaker">{{#if portrait}}<img class="tbg-bubble__portrait" src="{{portrait}}" alt="">{{/if}}<span class="tbg-bubble__name">{{name}}</span></span> {{/if}}{{#if icon}}<img class="tbg-bubble__icon" src="{{icon}}" alt="">{{else if iconClass}}<i class="tbg-bubble__icon {{iconClass}}" inert></i>{{/if}}<span class="tbg-bubble__text">{{{content}}}</span>
</div>
