{
  "id": "tbg",
  "title": "TBG",
  "description": "Balões de fala estilo Habbo sobre os tokens, Modo Narrador para o Mestre e um chat melhor para o Foundry VTT v14. — Habbo-style speech bubbles over tokens, a Narrator mode for the GM and a better chat for Foundry VTT v14.",
  "version": "0.3.0",
  "type": "module",
  "authors": [
    {
      "name": "rezendesjoao",
      "url": "https://github.com/rezendesjoao"
    }
  ],
  "url": "https://github.com/rezendesjoao/tbg",
  "bugs": "https://github.com/rezendesjoao/tbg/issues",
  "readme": "https://github.com/rezendesjoao/tbg#readme",
  "changelog": "https://github.com/rezendesjoao/tbg/blob/main/CHANGELOG.md",
  "license": "MIT",
  "manifest": "https://github.com/rezendesjoao/tbg/releases/latest/download/module.json",
  "download": "https://github.com/rezendesjoao/tbg/releases/download/v0.3.0/module.zip",
  "media": [],
  "compatibility": {
    "minimum": "14",
    "verified": "14.367"
  },
  "esmodules": [
    "scripts/tbg.mjs"
  ],
  "styles": [
    "styles/tbg.css",
    "styles/bubbles.css",
    "styles/chat.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ],
  "socket": true,
  "relationships": {
    "recommends": [
      {
        "id": "narrator-tools",
        "type": "module",
        "reason": "Narração em tela (cutscene). O TBG delega /cena para ele quando presente."
      },
      {
        "id": "custom-chat-tabs",
        "type": "module",
        "reason": "Abas IC / OOC / Rolagens / Sussurros. O TBG marca as mensagens para serem filtráveis."
      },
      {
        "id": "CautiousGamemastersPack",
        "type": "module",
        "reason": "Modos de falante IC/OOC forçados e /desc, /as. O TBG é compatível e não duplica."
      }
    ]
  },
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang"]
    }
  }
}
